# Build context is backend/. Keep it small and never ship host-built artifacts
# into the image — deps are installed fresh and the app is compiled in the build.

# Host dependencies (native modules like bcrypt are built for the host OS/arch)
node_modules

# Build output (regenerated by `pnpm build` inside the image)
dist
*.tsbuildinfo

# Secrets / local env — but keep the example for reference
.env
.env.*
!.env.example

# Docker + compose files don't belong inside the image
Dockerfile
.dockerignore
docker-compose.yaml
docker-compose.yml

# VCS / editor / logs
.git
.gitignore
.vscode
.idea
*.log
pnpm-debug.log*

# Uploaded files (runtime data, not part of the image)
uploads
