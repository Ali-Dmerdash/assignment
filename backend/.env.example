# Copy to `.env` and fill in. All values are required (no in-code defaults).

# Port the API listens on
PORT=5000

# MongoDB connection string — local Docker Mongo, or your Atlas URI in deploy
MONGO_URI=mongodb://localhost:27017/jobboard

# JWT signing secret — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Directory where uploaded CVs are written (the mounted volume in Docker)
UPLOAD_DIR=./uploads
