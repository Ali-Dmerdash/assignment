# Copy this file to `.env` and replace the example values below.
# All are required — the server refuses to start if any is missing (no in-code defaults).

# Port the API listens on
PORT=5000

# MongoDB connection string — local Docker Mongo, or your Atlas URI in prod
MONGO_URI=mongodb://localhost:27017/your-database-name

# JWT signing secret — generate your own, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-a-long-random-secret

# Directory where uploaded CVs are written (the mounted volume in Docker)
UPLOAD_DIR=./uploads

# Allowed frontend origin for CORS (REST + Socket.io); the deployed URL in prod
CORS_ORIGIN=http://localhost:3000
